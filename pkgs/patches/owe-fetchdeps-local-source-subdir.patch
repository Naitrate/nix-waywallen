--- a/cmake/FetchDeps.cmake	2026-07-25 16:54:17.247623860 -0700
+++ b/cmake/FetchDeps.cmake	2026-07-25 16:55:11.417326269 -0700
@@ -169,7 +169,27 @@
     elseif(DEFINED FETCHDEPS_LOCAL_${_fd_name}
            AND EXISTS "${FETCHDEPS_LOCAL_${_fd_name}}")
       message(STATUS "fetchdeps: ${_fd_name} <- local override ${FETCHDEPS_LOCAL_${_fd_name}}")
-      add_subdirectory("${FETCHDEPS_LOCAL_${_fd_name}}" "${_fd_name}")
+      # Mirror the Flatpak provider: honor source_subdir, skip missing
+      # CMakeLists (cmake-noop), SetPopulated, then GetProperties so
+      # ${_fd_name}_SOURCE_DIR is visible to the caller.
+      set(_fd_src "${FETCHDEPS_LOCAL_${_fd_name}}")
+      set(_fd_bin "${CMAKE_BINARY_DIR}/_deps/${_fd_name}-build")
+      set(_fd_add_src "${_fd_src}")
+      _fetchdeps_json_has_key(_fd_has_xc "${_fd_entry}" "x-cmake")
+      if(_fd_has_xc)
+        string(JSON _fd_xc GET "${_fd_entry}" "x-cmake")
+        _fetchdeps_json_get_opt(_fd_subdir "${_fd_xc}" source_subdir)
+        if(_fd_subdir)
+          set(_fd_add_src "${_fd_src}/${_fd_subdir}")
+        endif()
+      endif()
+      if(EXISTS "${_fd_add_src}/CMakeLists.txt")
+        add_subdirectory("${_fd_add_src}" "${_fd_bin}")
+      endif()
+      FetchContent_SetPopulated(${_fd_name}
+        SOURCE_DIR "${_fd_src}"
+        BINARY_DIR "${_fd_bin}")
+      FetchContent_GetProperties(${_fd_name})
       set(_fd_did_load TRUE)
     elseif(EXISTS "${_fd_source_root}/${_fd_name}")
       message(STATUS "fetchdeps: ${_fd_name} <- local ${_fd_source_root}/${_fd_name}")
